# ============================================================
# NoneadCSS 离线安装包环境变量模板
#
# 【部署必读】
# 1. 复制本文件为 .env：cp .env.example .env   （或运行 install 脚本自动生成）
# 2. 运行密钥生成脚本生成真实密钥（推荐），或手工填写随机值：
#      Windows:  powershell -ExecutionPolicy Bypass -File .\generate-secrets.ps1
#      Linux:    ./generate-secrets.sh
# 3. .env 包含生产密钥，严禁提交到 Git 或随包外发后原样使用，
#    正式投入使用前建议轮换（重新运行 generate-secrets 脚本）。
# ============================================================

# 宿主机对外端口（容器内固定 5000）
HOST_PORT=5173

# ============================================================
# 应用密钥（首次部署请替换为随机值；使用 generate-secrets 脚本生成）
# 注意：密钥字符集中不含 $ 与 #，避免 docker compose 变量插值破坏
# ============================================================

# JWT 签名密钥（HMAC-SHA512，必须 >= 64 字节 Base64；推荐 512-bit）
JWT__Key=<REPLACE_WITH_64BYTES_BASE64_RANDOM>

# 密码哈希增强密钥（必须 >= 64 字节 Base64；与 JWT 密钥必须不同）
SECRET_HASHER__Key=<REPLACE_WITH_64BYTES_BASE64_RANDOM>

# AES-256 数据加密密钥（必须 32 字节 Base64；绝对不可泄露）
ENCRYPTION__Key=<REPLACE_WITH_32BYTES_BASE64_RANDOM>

# （可选）旧版 SHA256 派生密钥，用于向后兼容历史加密数据
ENCRYPTION__LegacySha256Key=

# 审计日志 HMAC 签名密钥（任意长度 ASCII）
AUDIT__HmacKey=<REPLACE_WITH_64CHARS_ASCII_RANDOM>

# 满意度评价 Token 签名密钥（>= 32 字节 UTF-8）
APP__SatisfactionTokenKey=<REPLACE_WITH_AT_LEAST_32CHARS_RANDOM>

# ============================================================
# 超级管理员账号（首次冷启动 / Users 表为空时自动创建）
# 生产环境（ASPNETCORE_ENVIRONMENT != Development）必须显式设置，缺失将中止启动！
# 首次部署成功后立即登录并修改管理员密码。
# ============================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# ============================================================
# 高级选项（一般无需更改）
# ============================================================
# 迁移前自动冷备数据库（离线安装为全新库，保持 true 跳过冷备）
DB__SkipBackupBeforeMigrate=true

# 反向代理信任列表：多级反代部署时填入反代 IP（逗号分隔）。
# 默认信任 Docker 默认网关 172.17.0.1（镜像内限流中间件 KnownProxies 基线），
# 若宿主机网关不同（非默认 bridge 网络）请显式覆盖。
ForwardedHeaders__KnownProxies=172.17.0.1
