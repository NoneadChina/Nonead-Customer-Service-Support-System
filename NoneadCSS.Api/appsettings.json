{
  // === Serilog 日志配置 ===
  // 输出模板包含 {SourceContext}，便于按类名筛选日志
  // 日志文件路径可通过环境变量覆盖：Serilog__WriteTo__1__Args__path=/var/log/ncss/log.txt
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Quartz": "Warning",
        "System.Net.Http": "Warning",
        "NoneadCSS.Infrastructure.Services.WeChat.WeChatAccessTokenService": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 180,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/archive-/archive-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Warning",
          "retainedFileCountLimit": null,
          "fileSizeLimitBytes": null,
          "rollOnFileSizeLimit": false,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  // === Microsoft 日志配置 ===
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // === 服务监听地址 ===
  "Urls": "http://127.0.0.1:5008",
  "AllowedHosts": "localhost;127.0.0.1;nonead.com;*.nonead.com;css.example.com;*.css.example.com",
  // === 数据库配置 ===
  "Database": {
    "UseSqlite": true
  },
  "ConnectionStrings": {
    "_comment": "生产环境必须通过环境变量配置：ConnectionStrings__DefaultConnection / ConnectionStrings__SqliteConnection。开发环境值见 appsettings.Development.json。",
    "DefaultConnection": "",
    "SqliteConnection": ""
  },
  // === JWT 认证配置 ===
  "Jwt": {
    "_comment": "JWT 配置说明：生产环境必须使用环境变量 JWT__Key。开发环境配置固定密钥以避免重启后所有用户被踢下线。",
    "_env_vars": "支持的变量名：JWT__Key / JWT_KEY, JWT__Issuer / JWT_ISSUER, JWT__Audience / JWT_AUDIENCE, JWT__AccessTokenExpireMinutes, JWT__RefreshTokenExpireDays",
    "SecretKey": "",
    "Issuer": "NoneadCSS",
    "Audience": "NoneadCSSApi",
    "AccessTokenExpireMinutes": "60",
    "RefreshTokenExpireDays": "7"
  },
  // === AES 加密密钥配置 ===
  "Encryption": {
    "_comment": "AES 加密密钥：生产环境必须使用环境变量 ENCRYPTION__Key。开发环境配置固定密钥以避免重启后已加密数据无法解密。",
    "Key": ""
  },
  // === 审计日志 HMAC 签名密钥 ===
  "Audit": {
    "_comment": "审计日志 HMAC-SHA256 签名密钥：生产环境使用环境变量 AUDIT__HmacKey。未配置时回退到 Encryption:Key（带域分隔符）。",
    "HmacKey": ""
  },
  // === 邮件收取配置 ===
  "Email": {
    "MaxAttachmentSize": 20971520,
    "FetchCron": "0 */5 * * * ?",
    "FetchEnabled": true,
    "ContactCollectionEnabled": true
  },
  // === Quartz 定时任务配置 ===
  "Quartz": {
    "Jobs": {
      "SlaScan": "0 0/30 * * * ?",
      "CalendarReminder": "0 * * * * ?",
      "FetchEmail": "0 0/3 * * * ?",
      "ProcessEmailQueue": "0 * * * * ?",
      "PurgeCalendarTrash": "0 0 3 * * ?",
      "OutlookCalendarSync": "0 0/30 * * * ?",
      "ProcessCustomReportSchedules": "0 0/5 * * * ?"
    },
    // === Quartz 集群存储（M7）===
    // 单实例部署保持 Enabled=false（RAMJobStore，无额外依赖）；
    // 多实例部署需设为 true，并确保所有实例共享同一 SQLite 数据库文件。
    // 首次启动会自动创建 QRTZ_ 表。SQLite 是单写者数据库，多实例同时写入时
    // 依赖 busy timeout 串行化，仅适用于中小规模部署。
    "Cluster": {
      "Enabled": false,
      "CheckinIntervalSeconds": 15,
      "CheckinMisfireThresholdSeconds": 30,
      "RetryIntervalSeconds": 15
    }
  },
  // === 日历模块配置 ===
  // TrashRetentionDays: 回收站自动清除保留天数（PurgeCalendarTrash 调度对应天数）
  // ScanWindowHours: 日历提醒扫描窗口（小时），扫描 [now-ScanLookbackMinutes, now+ScanWindowHours] 范围
  // ScanLookbackMinutes: 日历提醒扫描回溯时间（分钟），避免准时提醒因扫描间隔错过触发
  // ScanOverdueExpireHours: 过期提醒补发截止时间（小时），超过此时间的过期提醒不再补发
  // ReminderConfirmationWindowMinutes: 提醒确认窗口（分钟），超时未确认则触发兜底补发
  // MaxRecurrenceInstances: 重复日程展开最大实例数
  // DefaultPageSize: 日历列表默认分页大小
  // OutlookSyncIntervalMinutes: Outlook 双向同步最小间隔（用于前端触发后冷却，避免频繁同步）
  // OutlookSyncConflictStrategy: 冲突处理策略 (last_write_wins / outlook_wins / local_wins / manual)
  "Calendar": {
    "TrashRetentionDays": 30,
    "ScanWindowHours": 2,
    "ScanLookbackMinutes": 60,
    "ScanOverdueExpireHours": 2,
    "ReminderConfirmationWindowMinutes": 5,
    "MaxRecurrenceInstances": 365,
    "DefaultPageSize": 50,
    "OutlookSyncIntervalMinutes": 15,
    "OutlookSyncConflictStrategy": "last_write_wins"
  },
  // === Azure AD / Microsoft Graph 配置 ===
  // 用于 Outlook 日历双向同步的 OAuth 2.0 授权码流程
  // 生产环境必须使用环境变量覆盖：AzureAd__ClientId / AzureAd__ClientSecret / AzureAd__TenantId
  // 应用注册说明：
  //   1. 在 Azure Portal -> App registrations 注册一个应用
  //   2. 添加平台 "Web"，重定向 URI 设为 AzureAd:RedirectUri（如 https://your-domain/api/outlooksync/oauth/callback）
  //   3. 添加证书/密钥，将客户端密码填入 AzureAd:ClientSecret
  //   4. API 权限添加 Microsoft Graph -> Calendars.ReadWrite（委托权限）
  //   5. 可选：添加 offline_access 权限以获取刷新令牌
  "AzureAd": {
    "_comment": "Outlook 日历同步 OAuth 配置。生产环境必须通过环境变量覆盖所有敏感字段。",
    "_env_vars": "AzureAd__ClientId / AzureAd__ClientSecret / AzureAd__TenantId / AzureAd__RedirectUri",
    "ClientId": "",
    "ClientSecret": "",
    "TenantId": "common",
    "RedirectUri": "http://localhost:5008/api/outlooksync/oauth/callback",
    "Scopes": "Calendars.ReadWrite offline_access User.Read",
    "AuthorizeUrl": "https://login.microsoftonline.com/{0}/oauth2/v2.0/authorize",
    "TokenUrl": "https://login.microsoftonline.com/{0}/oauth2/v2.0/token",
    "GraphBaseUrl": "https://graph.microsoft.com/v1.0"
  },
  // === 附件上传配置 ===
  // 安全说明：UploadPath 必须位于 wwwroot 之外，避免上传文件被静态文件中间件直接访问（XSS 风险）。
  // 所有附件下载必须经 AttachmentsController 鉴权后通过 FileResult 返回。
  "Attachment": {
    "MaxSize": 26214400,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".zip", ".rar", ".mp3", ".wav", ".amr", ".m4a", ".aac", ".ogg", ".mp4", ".mov", ".avi", ".mkv", ".webm", ".3gp"],
    "AllowedMimeTypes": ["image/", "application/pdf", "application/vnd.openxmlformats-officedocument.", "application/vnd.ms-excel", "application/vnd.ms-powerpoint", "application/vnd.ms-word", "text/", "application/zip", "application/x-rar-compressed", "audio/", "video/"],
    "UploadPath": "Data/Attachments"
  },
  // 病毒扫描配置：启用 ClamAV 需先安装并运行 ClamAV 守护进程（默认端口 3310）
  // 安全建议：生产环境应通过环境变量 VirusScan__EnableClamAv=true 启用 ClamAV。
  // BlockOnClamAvUnavailable=true 表示 ClamAV 不可用时阻止上传（fail-closed），
  // 防止恶意文件在扫描服务降级时绕过检测。
  "VirusScan": {
    "EnableClamAv": false,
    "ClamAvHost": "localhost",
    "ClamAvPort": 3310,
    "ClamAvTimeoutMs": 5000,
    "BlockOnClamAvUnavailable": true
  },
  // === 应用前端 URL 配置 ===
  // M-2 安全说明：以下 FrontendUrl/BaseUrl 默认值为开发环境 HTTP 地址，仅用于本地调试。
  // 生产环境必须通过环境变量 APP__FrontendUrl 和 APP__BaseUrl 覆盖为 HTTPS 地址，
  // 否则后台任务（密码重置邮件、通知链接、邮件追踪像素等）生成的链接将使用 HTTP，
  // 存在中间人窃听/篡改风险。默认值不改为 HTTPS 是为了开发环境不强制配置证书。
  "App": {
    "_comment": "FrontendUrl/BaseUrl 作为后台任务（无 HTTP 上下文）的回退值。HTTP 请求上下文可用时由 IFrontendUrlResolver 动态从当前请求提取 scheme://host（多域名部署自动适配）。SatisfactionTokenKey 用于满意度评价令牌的签名，发送端和验证端必须一致，长度≥32字节。",
    "_https_warning": "生产环境必须通过环境变量 APP__FrontendUrl / APP__BaseUrl 覆盖为 HTTPS，否则后台任务（密码重置邮件、通知链接等）发出的链接会使用 HTTP，存在中间人风险。例：APP__FrontendUrl=https://css.example.com",
    "FrontendUrl": "https://css.example.com",
    "BaseUrl": "https://css.example.com",
    "SatisfactionTokenKey": ""
  },
  // === 品牌配置 — 统一所有模板中使用的系统级变量来源 ===
  "Brand": {
    "CompanyName": "拓德科技",
    "LoginUrl": "http://css.example.com:5173/login",
    "FrontendUrl": "http://css.example.com:5173",
    "SupportEmail": "support@example.com"
  },
  // === 微信服务号接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // 出站微信 API 固定直连微信公众平台官方地址 https://api.weixin.qq.com/cgi-bin/...，无需网关密钥配置。
  // 服务器出网需可访问 api.weixin.qq.com，并在公众平台后台把出网 IP 加入白名单。
  // CallbackBaseUrl 为对外公布的公网 HTTPS 回调基址（如 https://css.example.com），
  // 部署时由运维通过环境变量 WeChat__CallbackBaseUrl 设置为自有域名；留空表示未配置。
  "WeChat": {
    "AppId": "",
    "AppSecret": "",
    "Token": "",
    "EncodingAESKey": "",
    "EncryptMode": "plain",
    "MailboxId": null,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false,
    "CallbackPath": "/api/wechat",
    "CallbackBaseUrl": ""
  },
  // === WhatsApp Business Platform 接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  "WhatsApp": {
    "PhoneNumberId": "",
    "AccessToken": "",
    "AppSecret": "",
    "VerifyToken": "",
    "BusinessPhoneNumber": "",
    "ApiVersion": "v24.0",
    "MailboxId": null,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false,
    "CallbackPath": "/api/whatsapp"
  },
  // === 飞书机器人应用接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  "Feishu": {
    "AppId": "",
    "AppSecret": "",
    "VerificationToken": "",
    "EncryptKey": "",
    "EncryptEnabled": false,
    "MailboxId": null,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false,
    "CallbackPath": "/api/feishu"
  },
  // === DingTalk 钉钉开放平台接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // 敏感字段（AppSecret、CallbackToken、EncodingAesKey）在数据库中以 AES 加密存储
  "DingDing": {
    "AppKey": "",
    "AppSecret": "",
    "AgentId": null,
    "RobotCode": "",
    "CallbackToken": "",
    "EncodingAesKey": "",
    "ReceiveMode": "Http",
    "MailboxId": null,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false,
    "CallbackPath": "/api/dingding"
  },
  // === Messenger Platform（Meta Graph API）接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // 出站固定直连 https://graph.facebook.com/{ApiVersion}/...；Meta 无 v2x 别名，版本号必须保持为配置项。
  // AppSecret 用于校验回调头 X-Hub-Signature-256（HMAC-SHA256，常量时间比较），VerifyToken 用于 GET 订阅校验。
  // Page Access Token 无刷新接口（约 60 天到期，business/system-user 场景可长期有效），到期需人工更换。
  // 24 小时客服窗口外的出站需 MessageTag（默认 HUMAN_AGENT），策略见 MessageTagPolicy。
  "Messenger": {
    "AppId": "",
    "AppSecret": "",
    "PageId": "",
    "PageAccessToken": "",
    "VerifyToken": "",
    "PageUsername": "",
    "ApiVersion": "v25.0",
    "MailboxId": null,
    "CallbackPath": "/api/messenger",
    "TextChunkChars": 2000,
    "WindowHours": 24,
    "WarningThresholdHours": 4,
    "MessageTagPolicy": "auto",
    "MessageTag": "HUMAN_AGENT",
    "TypingIndicator": true,
    "MarkSeen": true,
    "ContactCollectionEnabled": true,
    "SubscribedFields": "messages,messaging_postbacks,messaging_optins,message_deliveries,message_reads",
    "MediaDownloadMaxMB": 25,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false
  },
  // === Telegram Bot API 接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // 出站直连 https://api.telegram.org/bot<BotToken>/<method>；自建 Bot API 服务时把 ApiBaseUrl 改为 http(s)://<host>:8081。
  // Mode=webhook 时必须配置 WebhookSecretToken（Telegram 不签名请求体，secret_token 是唯一入站来源校验）；
  // Mode=polling 时由 TelegramPollingHostedService 长轮询，二者互斥（否则会 409 Conflict）。
  // Bot Token 属凭据，只经环境变量 TELEGRAM__BotToken 注入，切勿写入本文件。
  "Telegram": {
    "Mode": "webhook",
    "BotToken": "",
    "ApiBaseUrl": "https://api.telegram.org",
    "UseLocalBotApiServer": false,
    "CallbackPath": "/api/telegram/webhook",
    "WebhookUrl": "",
    "WebhookSecretToken": "",
    "WebhookIpAddress": "",
    "MaxWebhookConnections": 40,
    "PollingTimeout": 25,
    "PollingLimit": 100,
    "DeleteWebhookOnSwitch": true,
    "AcceptGroupMessages": false,
    "MailboxId": null,
    "ConversationMatchWindowHours": 720,
    "MaxMessageChars": 4096,
    "RateLimitGlobalPerSeconds": 25,
    "RateLimitPerChatPerSeconds": 1,
    "MaxLocalBackoffSeconds": 10,
    "LinkTokenHmacKey": "",
    "LinkTokenTtlMinutes": 30,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false
  },
  // === LINE Messaging API 接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // Channel Access Token 长期令牌不过期但也不会刷新，泄露即等同凭据泄露 —— 只经环境变量 LINE__ChannelAccessToken 注入。
  // ChannelSecret 用于校验回调头 X-Line-Signature（Base64(HMAC-SHA256(raw body, ChannelSecret))）。
  // LINE 没有聊天媒体上传接口：出站附件必须由本系统公网 HTTPS 地址直链提供（AttachmentPublicBaseUrl），
  // 例 https://css.example.com，链接带 exp+sig 签名，TTL 见 AttachmentPublicUrlTtlMinutes。
  "Line": {
    "ChannelId": "",
    "ChannelSecret": "",
    "ChannelAccessToken": "",
    "ChannelAccessTokenKeyId": "",
    "ApiBaseUrl": "https://api.line.me",
    "DataApiBaseUrl": "https://api-data.line.me",
    "AttachmentPublicBaseUrl": "",
    "AttachmentPublicUrlTtlMinutes": 10080,
    "WebhookEnabled": true,
    "WebhookPath": "/api/line/webhook",
    "RichMenuId": "",
    "MarkAsReadEnabled": true,
    "LoadingIndicatorEnabled": false,
    "ProfileEnrichEnabled": true,
    "TextChunkChars": 5000,
    "MaxMessagesPerRequest": 5,
    "ReplyTokenTtlSeconds": 25,
    "HumanHandoverMuteMinutes": 60,
    "QuotaWarnPercent": 80,
    "RetryMaxAttempts": 1,
    "OutboundImageExtensions": "jpg,jpeg,png",
    "MailboxId": null,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false
  },
  // === iMessage / Apple Messages 接入配置（基线，运行时由 SystemOptions 数据库覆盖） ===
  // 一套抽象两种传输：Mode=bridge（默认，指向自建 macOS 上的 BlueBubbles 服务，凭据为桥接服务密码）；
  // Mode=amb_msp / amb_apple_direct（Apple Messages for Business，需 Apple 核准的 MSP 身份，默认不可用）。
  // 桥接服务地址与密码只经环境变量 IMESSAGE__BaseUrl / IMESSAGE__Password 注入；桥接服务应监听 127.0.0.1 并由本系统单点访问。
  // Apple 无 24/48 小时窗口概念（按会话投递，不会冷启动发消息），匹配窗口仅用于本地会话归组。
  "IMessage": {
    "Mode": "bridge",
    "BaseUrl": "",
    "AuthStyle": "bearer",
    "Password": "",
    "WebhookPath": "/api/imessage/bluebubbles/webhook",
    "WebhookBaseUrl": "",
    "SendMethod": "apple-script",
    "AllowSmsFallback": false,
    "AllowList": "",
    "RateLimitPerMinute": 20,
    "VerifyTls": true,
    "HealthEndpoint": "/api/v1/ping",
    "MinServerVersion": "1.0.0",
    "ReadHistoryOnStart": false,
    "MatchWindowHours": 168,
    "MailboxId": null,
    "MspConnector": "",
    "ApiBaseUrl": "",
    "ApiKey": "",
    "WebhookSecret": "",
    "BusinessIdentifier": "",
    "BusinessId": "",
    "GatewayBaseUrl": "https://mspgw.push.apple.com",
    "InboundPath": "/message",
    "FallbackChannel": "none",
    "TokenTtlSeconds": 3600,
    "MaxBodyBytes": 2097152,
    "AutoReplyEnabled": false,
    "AutoReplyMessage": "",
    "Enabled": false
  },
  // === 安全配置 ===
  "Performance": {
    "_comment": "性能与超时配置：所有 TimeSpan 值均可通过环境变量覆盖，如 Performance__Chat__MessageRecallWindowMinutes",
    "Chat": {
      "MessageRecallWindowMinutes": 2
    },
    "Cache": {
      "DefaultCacheMinutes": 10,
      "MailboxCacheMinutes": 5,
      "PasswordPolicyCacheMinutes": 5,
      "LocalizationRefreshIntervalMinutes": 9,
      "ChannelSettingsCacheMinutes": 10
    },
    "IngestionMatch": {
      "WeChatMatchWindowHours": 48,
      "DingDingMatchWindowHours": 72,
      "FeishuMatchWindowHours": 48,
      "WhatsAppMatchWindowHours": 24,
      "WhatsAppWarningThresholdHours": 4
    },
    "HttpClient": {
      "StandardTimeoutSeconds": 30,
      "TokenServiceTimeoutSeconds": 15,
      "WebhookTimeoutSeconds": 10,
      "OutlookGraphTimeoutSeconds": 60,
      "WeChatMediaDownloadTimeoutSeconds": 15
    },
    "ResponseCaching": {
      "ManagementListCacheMinutes": 5,
      "SystemOptionsCacheMinutes": 10,
      "AuditLogCacheMinutes": 1
    },
    "RateLimit": {
      "PerMinuteWindowSeconds": 60,
      "PerHourWindowSeconds": 3600
    },
    "SignalR": {
      "KeepAliveIntervalSeconds": 15,
      "ClientTimeoutIntervalSeconds": 30
    },
    "TokenRefresh": {
      "RefreshBufferMinutes": 5
    },
    "Retry": {
      "EmailFirstRetryDelayMinutes": 5
    },
    "Knowledge": {
      "LikeDedupWindowHours": 24
    }
  },
  "Security": {
    "_comment": "HTTPS 重定向：生产/Docker 环境下建议通过反向代理处理 HTTPS，容器内部使用 HTTP；本地开发可启用 HTTPS 重定向。",
    "EnableHttpsRedirection": false,
    "PasswordPolicy": {
      "_comment": "密码策略静态基线：作为最低安全标准，PasswordPolicyService 会与数据库 SystemOption 取并集（更严格者生效），防止运维误关",
      "MinLength": 10,
      "MaxLength": 1024,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    },
    "LoginLockout": {
      "_comment": "登录锁定策略：连续失败达到阈值后锁定账号指定时长，防止暴力破解。可通过环境变量覆盖：Security__LoginLockout__Threshold / Security__LoginLockout__DurationMinutes。",
      "Threshold": 5,
      "DurationMinutes": 15
    },
    "PasswordReset": {
      "_comment": "密码重置令牌有效期（小时）。可通过环境变量覆盖：Security__PasswordReset__TokenExpireHours。",
      "TokenExpireHours": 24
    },
    "Metrics": {
      "_comment": "/metrics Prometheus 端点访问控制。不在 AllowedIpRanges 内的请求强制要求 SuperAdmin 角色。环境变量前缀：Security__Metrics__。",
      "RequireSuperAdmin": true,
