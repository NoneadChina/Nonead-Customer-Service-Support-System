@echo off
REM Copy this file to deploy\secrets.cmd, fill in real values, and NEVER commit it
REM (deploy/secrets.cmd is listed in .gitignore). deploy/_start-backend.cmd loads it.
REM Generate strong random values, e.g.:
REM   PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})

REM --- signing / encryption (rotate immediately if a value was ever committed) ---
set "JWT__Key=<REPLACE_WITH_64+_CHAR_RANDOM_SECRET>"
set "ENCRYPTION__Key=<REPLACE_WITH_BASE64_32_BYTE_KEY>"
set "AUDIT__HmacKey=<REPLACE_WITH_64+_CHAR_RANDOM_SECRET>"
set "APP__SatisfactionTokenKey=<REPLACE_WITH_64+_CHAR_RANDOM_SECRET>"
set "SECRET_HASHER__Key=<REPLACE_WITH_BASE64_64_BYTE_KEY>"

REM --- first-run super admin (required outside Development) ---
set "ADMIN_EMAIL=admin@example.com"
set "ADMIN_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>"

REM --- outbound / callbacks ---
set "APP__FrontendUrl=https://css.example.com"
set "APP__BaseUrl=https://css.example.com"
